msgid "CAGED Adjustments only exist for years up to {.val {ano_limite}}."
msgstr "Os Ajustes do CAGED só existem para anos até {.val {ano_limite}}."

msgid "Ignored years: {.val {invalid_years}}"
msgstr "Anos ignorados: {.val {invalid_years}}"

msgid "No valid year. CAGED Adjustments cover up to {.val {ano_limite}}."
msgstr "Nenhum ano válido. Os Ajustes do CAGED vão até {.val {ano_limite}}."

msgid "Years : {years[1]}-{years[length(years)]}"
msgstr "Anos : {years[1]}-{years[length(years)]}"

msgid "Months: {months[1]}-{months[length(months)]}"
msgstr "Meses: {months[1]}-{months[length(months)]}"

msgid "DB    : {.path {db_path}}"
msgstr "Banco: {.path {db_path}}"

msgid "1/3  Download"
msgstr "1/3  Download"

msgid "No download tasks generated."
msgstr "Nenhuma tarefa de download gerada."

msgid "{nrow(tasks)} file{?s} to process"
msgstr "{nrow(tasks)} arquivo{?s} a processar"

msgid "Cache: {.path {cache}}"
msgstr "Cache: {.path {cache}}"

msgid "Summary"
msgstr "Resumo"

msgid "No files available to process."
msgstr "Nenhum arquivo disponível para processar."

msgid "2/3  Parse and load into DuckDB"
msgstr "2/3  Leitura e carga no DuckDB"

msgid "Files"
msgstr "Arquivos"

msgid "Error in {.path {basename(arq)}}: {conditionMessage(e)}"
msgstr "Erro em {.path {basename(arq)}}: {conditionMessage(e)}"

msgid "3/3  Done"
msgstr "3/3  Concluído"

msgid "Total inserted: {format(n_inserido_total, big.mark = ',')} records"
msgstr "Total inserido: {format(n_inserido_total, big.mark = ',')} registros"

msgid "{.arg n} must be a positive integer or {.code Inf}, not {.val {n}}."
msgstr "{.arg n} deve ser um inteiro positivo ou {.code Inf}, não {.val {n}}."

msgid "Querying HuggingFace repository ({.url {hf_api_url}})..."
msgstr "Consultando o repositório HuggingFace ({.url {hf_api_url}})..."

msgid "Could not access the HuggingFace repository."
msgstr "Não foi possível acessar o repositório HuggingFace."

msgid "Check your connection with {.fn caged_status}."
msgstr "Verifique sua conexão com {.fn caged_status}."

msgid ""
"Repository: {.url https://huggingface.co/datasets/alexsandroprado/caged}"
msgstr ""
"Repositório: {.url https://huggingface.co/datasets/alexsandroprado/caged}"

msgid "No year found in the HuggingFace repository for series '{type}'."
msgstr ""
"Nenhum ano encontrado no repositório HuggingFace para a série '{type}'."

msgid "No competency found in the HuggingFace repository."
msgstr "Nenhuma competência encontrada no repositório HuggingFace."

msgid "Available competencies - {serie}"
msgstr "Competências disponíveis - {serie}"

msgid "{nrow(resultado)} competenc{?y/ies} listed"
msgstr "{nrow(resultado)} competência{?s} listada{?s}"

msgid "Use {.code {cmd}} to download the most recent."
msgstr "Use {.code {cmd}} para baixar a mais recente."

msgid "Connected to {.path {db_path}}"
msgstr "Conectado a {.path {db_path}}"

msgid "Empty data.frame - nothing to write."
msgstr "data.frame vazio - nada a gravar."

msgid "{.arg db_path} or {.arg .con} must be provided."
msgstr "Informe {.arg db_path} ou {.arg .con}."

msgid "No competency column found in the data.frame."
msgstr "Nenhuma coluna de competência encontrada no data.frame."

msgid "Columns present: {.val {names(df)}}"
msgstr "Colunas presentes: {.val {names(df)}}"

msgid ""
"Expected: {.col competencia}, {.col competenciamov}, {.col competenciadec} "
"or {.col competencia_declarada}."
msgstr ""
"Esperado: {.col competencia}, {.col competenciamov}, {.col competenciadec} "
"ou {.col competencia_declarada}."

msgid "{n_antes - nrow(df)} row{?s} with invalid competency removed (NA/Inf)."
msgstr ""
"{n_antes - nrow(df)} linha{?s} com competência inválida removida{?s} (NA/"
"Inf)."

msgid "Empty data.frame after cleaning - nothing to write."
msgstr "data.frame vazio após a limpeza - nada a gravar."

msgid ""
"{length(ja_gravadas)} competenc{?y/ies} already in the database - skipping."
msgstr "{length(ja_gravadas)} competência{?s} já no banco - pulando."

msgid "Use {.code overwrite_competencies = TRUE} to force."
msgstr "Use {.code overwrite_competencies = TRUE} para forçar."

msgid "No new data to insert."
msgstr "Nenhum dado novo para inserir."

msgid ""
"{format(n_inserido, big.mark = ',')} {cli::qty(n_inserido)}record{?s} "
"inserted into {.val {table}}"
msgstr ""
"{format(n_inserido, big.mark = ',')} {cli::qty(n_inserido)}registro{?s} "
"inserido{?s} em {.val {table}}"

msgid "Database not found: {.path {db_path}}"
msgstr "Banco não encontrado: {.path {db_path}}"

msgid "No CAGED table found in {.path {db_path}}."
msgstr "Nenhuma tabela CAGED encontrada em {.path {db_path}}."

msgid "File size: {tamanho_str}"
msgstr "Tamanho do arquivo: {tamanho_str}"

msgid "Tables"
msgstr "Tabelas"

msgid "Records     : {format(s$registros, big.mark = ',')}"
msgstr "Registros   : {format(s$registros, big.mark = ',')}"

msgid "Periods     : {s$competencias}"
msgstr "Períodos    : {s$competencias}"

msgid "Column {.col fonte_tipo} not found."
msgstr "Coluna {.col fonte_tipo} não encontrada."

msgid "Provide {.arg table} manually."
msgstr "Informe {.arg table} manualmente."

msgid "The data.frame mixes CAGED types: {.val {tipos}}."
msgstr "O data.frame mistura tipos de CAGED: {.val {tipos}}."

msgid "Process and write each type separately."
msgstr "Processe e grave cada tipo separadamente."

msgid "Unknown type: {.val {tipos}}"
msgstr "Tipo desconhecido: {.val {tipos}}"

msgid "Table {.val {table}} created."
msgstr "Tabela {.val {table}} criada."

msgid "Series: {serie}"
msgstr "Série: {serie}"

msgid "Failed to query HuggingFace for '{serie}': {conditionMessage(e)}"
msgstr "Falha ao consultar o HuggingFace para '{serie}': {conditionMessage(e)}"

msgid "No competency found on HuggingFace."
msgstr "Nenhuma competência encontrada no HuggingFace."

msgid "Database already up to date."
msgstr "Banco já atualizado."

msgid "Available up to: {max(as.integer(disponiveis$competencia))}"
msgstr "Disponível até: {max(as.integer(disponiveis$competencia))}"

msgid "{length(faltantes)} competenc{?y/ies} to download"
msgstr "{length(faltantes)} competência{?s} a baixar"

msgid "Period: {min(faltantes)} - {max(faltantes)}"
msgstr "Período: {min(faltantes)} - {max(faltantes)}"

msgid "Error updating '{serie}': {conditionMessage(e)}"
msgstr "Erro ao atualizar '{serie}': {conditionMessage(e)}"

msgid "Database already up to date for all series."
msgstr "Banco já atualizado para todas as séries."

msgid "Directory created: {.path {output_dir}}"
msgstr "Diretório criado: {.path {output_dir}}"

msgid "{.arg partition_by} must be NULL or a character vector of column names."
msgstr "{.arg partition_by} deve ser NULL ou um vetor de nomes de colunas."

msgid "No CAGED table found in {.path {db_path}}"
msgstr "Nenhuma tabela CAGED encontrada em {.path {db_path}}"

msgid "Table{?s} not found: {.val {invalidas}}"
msgstr "Tabela{?s} não encontrada{?s}: {.val {invalidas}}"

msgid "Available: {.val {tabelas_disponiveis}}"
msgstr "Disponíveis: {.val {tabelas_disponiveis}}"

msgid "Exporting to Parquet"
msgstr "Exportando para Parquet"

msgid "{length(tabelas_exportar)} table{?s} to export"
msgstr "{length(tabelas_exportar)} tabela{?s} a exportar"

msgid "Output: {.path {output_dir}}"
msgstr "Saída: {.path {output_dir}}"

msgid "{tab}: already exists, skipping. Use {.code overwrite = TRUE}."
msgstr "{tab}: já existe, pulando. Use {.code overwrite = TRUE}."

msgid "{tab}: column{?s} {.val {ausentes}} not found; table not exported."
msgstr ""
"{tab}: coluna{?s} {.val {ausentes}} não encontrada{?s}; tabela não exportada."

msgid ""
"{tab}: {format(n_registros, big.mark = ',')} records -> {.path "
"{basename(destino)}}"
msgstr ""
"{tab}: {format(n_registros, big.mark = ',')} registros -> {.path "
"{basename(destino)}}"

msgid "Error exporting {tab}: {conditionMessage(e)}"
msgstr "Erro ao exportar {tab}: {conditionMessage(e)}"

msgid "Done"
msgstr "Concluído"

msgid "{sum(resultados$status == 'exportado')} table{?s} exported"
msgstr "{sum(resultados$status == 'exportado')} tabela{?s} exportada{?s}"

msgid "Invalid UF{?s}: {.val {invalidas}}"
msgstr "UF{?s} inválida{?s}: {.val {invalidas}}"

msgid "Use valid abbreviations: {.val {ufs_validas}}"
msgstr "Use siglas válidas: {.val {ufs_validas}}"

msgid "Invalid {.arg years} argument."
msgstr "Argumento {.arg years} inválido."

msgid "Provide a numeric vector of years between {min_year} and {ano_max}."
msgstr "Informe um vetor numérico de anos entre {min_year} e {ano_max}."

msgid "{.arg years} contains NA values."
msgstr "{.arg years} contém valores NA."

msgid "Invalid years: {.val {years[years < min_year | years > ano_max]}}"
msgstr "Anos inválidos: {.val {years[years < min_year | years > ano_max]}}"

msgid "Provide years between {min_year} and {ano_max}."
msgstr "Informe anos entre {min_year} e {ano_max}."

msgid "Invalid {.arg months} argument. Provide integers between 1 and 12."
msgstr "Argumento {.arg months} inválido. Informe inteiros entre 1 e 12."

msgid "{.arg months} contains NA values."
msgstr "{.arg months} contém valores NA."

msgid "Invalid months: {.val {months[months < 1L | months > 12L]}}"
msgstr "Meses inválidos: {.val {months[months < 1L | months > 12L]}}"

msgid "Provide integers between 1 and 12."
msgstr "Informe inteiros entre 1 e 12."

msgid "Invalid type: {.val {type}}. Use MOV, FOR, EXC, ANTIGO or AJUSTES."
msgstr "Tipo inválido: {.val {type}}. Use MOV, FOR, EXC, ANTIGO ou AJUSTES."

msgid "could not move downloaded file"
msgstr "não foi possível mover o arquivo baixado"

msgid "Failed to download {.url {url}} after 3 attempts. Skipping."
msgstr "Falha ao baixar {.url {url}} após 3 tentativas. Pulando."

msgid "File not found: {.path {path}}"
msgstr "Arquivo não encontrado: {.path {path}}"

msgid "Failed to extract {.path {basename(path)}}."
msgstr "Falha ao extrair {.path {basename(path)}}."

msgid "The file uses PPMd compression (advanced 7-Zip)."
msgstr "O arquivo usa compressão PPMd (7-Zip avançado)."

msgid "Install 7-Zip: {.url https://www.7-zip.org/download.html}"
msgstr "Instale o 7-Zip: {.url https://www.7-zip.org/download.html}"

msgid "The standard Windows installer is sufficient (no need to add to PATH)."
msgstr ""
"O instalador padrão do Windows é suficiente (não é preciso adicionar ao "
"PATH)."

msgid "No valid competency to download."
msgstr "Nenhuma competência válida para baixar."

msgid "Download CAGED Microdata"
msgstr "Download dos microdados do CAGED"

msgid "{n} file{?s} to process"
msgstr "{n} arquivo{?s} a processar"

msgid "Workers: {workers}"
msgstr "Downloads paralelos: {workers}"

msgid "Downloading"
msgstr "Baixando"

msgid "Bases: {.val {paste(bases, collapse = ', ')}}"
msgstr "Bases: {.val {paste(bases, collapse = ', ')}}"

msgid "Cache at {.path {cache}}"
msgstr "Cache em {.path {cache}}"

msgid "Listing - {.val {base_nome}}"
msgstr "Listando - {.val {base_nome}}"

msgid "Could not list {.val {pasta}} on HuggingFace."
msgstr "Não foi possível listar {.val {pasta}} no HuggingFace."

msgid "No layout found in {.val {pasta}}."
msgstr "Nenhum layout encontrado em {.val {pasta}}."

msgid "{nrow(tarefas)} file{?s} found."
msgstr "{nrow(tarefas)} arquivo{?s} encontrado{?s}."

msgid "No layout found to download."
msgstr "Nenhum layout encontrado para download."

msgid "Error reading {.path {path}}: {conditionMessage(e)}"
msgstr "Erro ao ler {.path {path}}: {conditionMessage(e)}"

msgid ""
"Streaming failed for {.path {basename(path)}}: {conditionMessage(e)}. Trying "
"extraction..."
msgstr ""
"A leitura em stream falhou em {.path {basename(path)}}: "
"{conditionMessage(e)}. Tentando extração..."

msgid "No .txt found in {.path {basename(path)}}. Skipping."
msgstr "Nenhum .txt encontrado em {.path {basename(path)}}. Pulando."

msgid "Failed to extract {.path {path}}: {conditionMessage(e)}"
msgstr "Falha ao extrair {.path {path}}: {conditionMessage(e)}"

msgid "No .txt found in {.path {path}}. Skipping."
msgstr "Nenhum .txt encontrado em {.path {path}}. Pulando."

msgid "No valid file to parse."
msgstr "Nenhum arquivo válido para ler."

msgid "Reading {length(paths)} file{?s}..."
msgstr "Lendo {length(paths)} arquivo{?s}..."

msgid "Error in {.path {basename(p)}}: {conditionMessage(e)}"
msgstr "Erro em {.path {basename(p)}}: {conditionMessage(e)}"

msgid "No data read."
msgstr "Nenhum dado lido."

msgid "The files are of different types: {.val {tipos}}."
msgstr "Os arquivos são de tipos diferentes: {.val {tipos}}."

msgid "Use {.fn caged_parse} separately for each type."
msgstr "Use {.fn caged_parse} separadamente para cada tipo."

msgid "{format(nrow(resultado), big.mark = ',')} records read"
msgstr "{format(nrow(resultado), big.mark = ',')} registros lidos"

msgid "{ncol(resultado)} column{?s}"
msgstr "{ncol(resultado)} coluna{?s}"

msgid "online"
msgstr "online"

msgid "HuggingFace repository {status_txt}"
msgstr "Repositório HuggingFace {status_txt}"

msgid "Latency: {latencia_ms} ms"
msgstr "Latência: {latencia_ms} ms"

msgid "Dataset: {.url {repo_url}}"
msgstr "Dataset: {.url {repo_url}}"

msgid "unavailable"
msgstr "indisponível"

msgid "Tested URL: {.url {url_teste}}"
msgstr "URL testada: {.url {url_teste}}"

msgid "Check your connection or try again later."
msgstr "Verifique sua conexão ou tente novamente mais tarde."

msgid "HuggingFace may be under temporary maintenance."
msgstr "O HuggingFace pode estar em manutenção temporária."

